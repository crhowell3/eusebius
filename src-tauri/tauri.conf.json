{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "eusebius",
    "version": "0.1.0",
    "identifier": "com.cam.eusebius",
    "build": {
        "beforeDevCommand": "trunk serve --release",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "trunk build --release",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "eusebius",
                "width": 1400,
                "height": 1000
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "sql": {
            "preloadConnections": ["sqlite:wscoc.db"]
        }
    }
}
