#!/usr/bin/env bash
set -eo pipefail

echo "Running pre-commit checks..."

MANIFEST="src-tauri/Cargo.toml"

say() { printf '\033[1;36m> %s\033[0m\n' "$*"; }
fail() { printf '\033[1;31mX %s\033[0m\n' "$*" >&2; exit 1; }

if ! git diff --cached --name-only --diff-filter=ACMR | grep -E '\.rs$|Cargo\.toml$\Cargo\.lock$' || true; then
    echo "No Rust files staged, skipping Rust checks."
    exit 0
fi

say "pre-commit: rustfmt"
cargo fmt --manifest-path "$MANIFEST" --check \
    || fail "Unformatted code. Run: cargo fmt --manifest-path"

say "pre-commit: clippy"
cargo clippy --manifest-path "$MANIFEST" --no-default-features --all-targets -- -D warnings \
    || fail "Clippy found issues. Fix them."
